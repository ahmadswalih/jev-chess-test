# ---------------------------------------------------------------------------
# Jev credentials. Set ONE of these two. OpenRouter is the default.
# ---------------------------------------------------------------------------

# Option A (default): OpenRouter's Decisions API.
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option B: TypeSafe direct. Key from https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Force a provider instead of auto-detecting from whichever key is set.
# openrouter -> POST https://openrouter.ai/api/alpha/decisions
# typesafe   -> POST https://api.typesafe.ai/v1/systemone
# JEV_PROVIDER=openrouter

# Model slug. Defaults per provider:
#   openrouter -> typesafe/jev-1.13   (or ~typesafe/jev-latest)
#   typesafe   -> jev-latest          (or a pinned id like jev-1.13.0)
# JEV_MODEL=typesafe/jev-1.13

# Override the API host, e.g. when proxying. The path is added by the provider.
# JEV_BASE_URL=

# Shown on OpenRouter's app leaderboards. Optional.
JEV_APP_URL=https://loopengine.tech
JEV_APP_NAME=Jev Chess

# Milliseconds Jev gets to answer before the local fallback engine plays.
# Keep this well under the blitz clock. 4500 is a sane default for 1+0.
JEV_MOVE_TIMEOUT_MS=4500

# Where the leaderboard SQLite file lives (relative paths resolve to cwd).
JEV_CHESS_DB=./data/jev-chess.db
