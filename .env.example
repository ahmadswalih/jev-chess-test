# ---------------------------------------------------------------------------
# Jev credentials. Set ONE of these two. OpenRouter is the default.
# ---------------------------------------------------------------------------

# Option A (default): OpenRouter's Decisions API.
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option B: TypeSafe direct. Key from https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Leaderboard storage
# ---------------------------------------------------------------------------
# Set DATABASE_URL and the app uses Postgres; leave it unset and it uses a
# local SQLite file. Serverless hosts (Vercel) MUST use Postgres -- their
# filesystem is read-only and per-instance, so SQLite data would not survive.
#
# On Vercel with the Neon integration you do NOT need to set this: Neon injects
# POSTGRES_URL (already the pooled endpoint) and the app reads that too.
#
# Setting it by hand, use the POOLED connection string, not the direct one:
#   Neon:      postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
#   Supabase:  postgres://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# Force a backend instead of inferring it from DATABASE_URL: postgres | sqlite
# JEV_STORE=

# SQLite file location, used only when DATABASE_URL is unset.
JEV_CHESS_DB=./data/jev-chess.db

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Force a provider instead of auto-detecting from whichever key is set.
# openrouter -> POST https://openrouter.ai/api/alpha/decisions
# typesafe   -> POST https://api.typesafe.ai/v1/systemone
# JEV_PROVIDER=openrouter

# Model slug. Defaults per provider:
#   openrouter -> typesafe/jev-1.13   (or ~typesafe/jev-latest)
#   typesafe   -> jev-latest          (or a pinned id like jev-1.13.0)
# JEV_MODEL=typesafe/jev-1.13

# Override the API host, e.g. when proxying. The path is added by the provider.
# JEV_BASE_URL=

# Canonical public origin, used for canonical links and for the absolute URLs
# in the Open Graph / Twitter card tags. Falls back to Vercel's deployment host
# and then to the production domain, but set it explicitly in production so the
# canonical never points at a *.vercel.app alias.
NEXT_PUBLIC_SITE_URL=https://beatjev.loopengine.tech

# Shown on OpenRouter's app leaderboards. Optional.
JEV_APP_URL=https://beatjev.loopengine.tech
JEV_APP_NAME=Jev Chess

# Milliseconds Jev gets to answer before the local fallback engine plays.
# Keep this well under the blitz clock. 4500 is a sane default for 1+0.
JEV_MOVE_TIMEOUT_MS=4500
